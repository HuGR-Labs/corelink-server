# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# cargo-mutants output
mutants.out/
mutants.out.old/

# cargo-fuzz local artifacts
crates/*/fuzz/target/
crates/*/fuzz/corpus/
crates/*/fuzz/artifacts/

# SBOM outputs (CI uploads via actions/upload-artifact; local rebuilds
# always regen from Cargo.lock per WI-S01-007 §6.1.4 — never commit).
# WP-7.2: .sbom/ contains committed CycloneDX artifacts; per-binary ephemeral
# *.cdx.json files emitted by cargo-cyclonedx are excluded (merged into workspace SBOM).
sbom/
**/bom.json
**/*.cdx.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.local
.env.*.local
.env.prod
.env.*.prod
.dev.vars

# Cloudflare / wrangler
.wrangler/
node_modules/

# Logs
*.log

# Dados locais de dev
/local-data/

# R-prep backup daily verification harness outputs (artifacts uploaded to
# GHA workflow per `.github/workflows/backup-daily-verify.yml`; local runs
# regen these every invocation).
/.backup-verify-logs/
/.backup-verify-metrics/

# Python venv para scripts de validação
.venv-specs/
.venv/
__pycache__/
*.pyc

# Autonomous driver runtime state
scripts/autonomous_state.json
scripts/autonomous_driver.log

# admin-ui workspace artifacts
apps/admin-ui/node_modules/
apps/admin-ui/.next/
apps/admin-ui/pnpm-lock.yaml
apps/admin-ui/tsconfig.tsbuildinfo

# Pentest evidence pack build output (regen via scripts/build-pentest-evidence-pack.sh)
/dist/
.claude/worktrees/
# Machine-local Claude Code loop/scheduler state — never committed.
.claude/scheduled_tasks.lock
.claude/*.lock

# LICENSE full-text files materialized by scripts/fetch-license-texts.sh
/LICENSE-APACHE-2.0.txt
/LICENSE-MIT.txt

# Endurance load test results — never commit (regen via scripts/run_24h_endurance.sh)
tests/load/results/
target-isolated
worker-configuration.d.ts

# TechLead orchestrator local state (machine-local; never committed — also
# enforced by the techlead git-hygiene-guard hook).
.techlead/

# npm lockfiles — this repo uses pnpm (pnpm-lock.yaml); never commit package-lock.json
package-lock.json
**/package-lock.json
target-cas-erase/
target-isolated/
.env.prod
