{
  "name": "corelink-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "CoreLink monorepo root (Rust crates + JS/TS apps via pnpm).",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "patchedDependencies": {
      "@docusaurus/core@3.10.1": "patches/@docusaurus__core@3.10.1.patch",
      "@opennextjs/aws@4.0.2": "patches/@opennextjs__aws@4.0.2.patch"
    },
    "overrides": {
      "@types/react": "^19.0.12",
      "js-cookie@<3.0.7": ">=3.0.7 <4",
      "postcss@<8.5.10": ">=8.5.10 <9",
      "qs@>=6.11.1 <6.15.2": ">=6.15.2 <7",
      "rollup@>=3.0.0 <3.30.0": ">=3.30.0 <4",
      "serialize-javascript@<7.0.5": ">=7.0.5 <8",
      "shell-quote@<1.8.4": ">=1.8.4 <2",
      "uuid@<11.1.1": ">=11.1.1 <12",
      "websocket-driver@<0.7.5": ">=0.7.5 <0.8",
      "ws@<7.5.11": ">=7.5.11 <8"
    }
  },
  "scripts": {
    "admin-ui:dev": "pnpm --filter @corelink/admin-ui dev",
    "admin-ui:build": "pnpm --filter @corelink/admin-ui build",
    "admin-ui:test": "pnpm --filter @corelink/admin-ui test",
    "admin-ui:lint": "pnpm --filter @corelink/admin-ui lint",
    "admin-ui:typecheck": "pnpm --filter @corelink/admin-ui typecheck",
    "docs:dev": "pnpm --filter @corelink/docs dev",
    "docs:build": "pnpm --filter @corelink/docs build",
    "docs:serve": "pnpm --filter @corelink/docs serve",
    "docs:test": "pnpm --filter @corelink/docs test",
    "docs:lint": "pnpm --filter @corelink/docs lint",
    "docs:typecheck": "pnpm --filter @corelink/docs typecheck",
    "docs:gen": "pnpm --filter @corelink/docs docs:gen",
    "docs:gen:check": "pnpm --filter @corelink/docs docs:gen:check",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "test": "pnpm -r --parallel test",
    "test:coverage": "pnpm -r test:coverage",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "wrangler": "^4.103.0"
  }
}
