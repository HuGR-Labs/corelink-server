# CoreLink Turborepo remote cache — copy to .env and fill in your values.
# Never commit .env; this file is safe to commit.

# Base URL of the CoreLink API (no trailing slash).
TURBO_API=https://corelink-api.humangr.com

# Personal Access Token issued by CoreLink (Settings → API tokens).
TURBO_TOKEN=<your-corelink-pat>

# Your CoreLink tenant UUID (shown on the Dashboard → Tenant page).
# Turborepo sends this as the `teamId` query parameter on every artifact request.
TURBO_TEAM=<your-tenant-uuid>
