{
  "name": "@corelink/signup-worker",
  "private": true,
  "version": "0.1.0",
  "description": "CoreLink signup-worker — Clerk + Stripe webhook receiver running on Cloudflare Workers (Phase-0 auto-provision-on-signup).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.64.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.103.0"
  }
}
