{
  "name": "@corelink/admin-ui",
  "version": "0.1.0",
  "private": true,
  "description": "CoreLink Admin UI — Next.js 15 + Clerk + hardened CSP + i18n (foundation per WI-S16-001).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "next-on-pages",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --reporter=verbose",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps",
    "e2e:list": "playwright test --list",
    "e2e:tests": "playwright test --config=playwright.tests.config.ts",
    "e2e:tests:list": "playwright test --config=playwright.tests.config.ts --list",
    "lhci": "lhci autorun --config=./lighthouserc.cjs"
  },
  "dependencies": {
    "@clerk/nextjs": "6.39.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@stripe/stripe-js": "^4.0.0",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "next": "15.5.18",
    "next-intl": "4.12.0",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "swr": "^2.2.5",
    "uuid": "^10.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.7",
    "@tailwindcss/postcss": "4.0.9",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/uuid": "^10.0.0",
    "@axe-core/playwright": "^4.10.1",
    "@lhci/cli": "0.14.0",
    "@playwright/test": "1.60.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "^3.0.7",
    "autoprefixer": "10.4.20",
    "axe-core": "^4.10.2",
    "eslint": "9.21.0",
    "eslint-config-next": "15.5.18",
    "happy-dom": "^20.9.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^26.0.0",
    "postcss": "8.5.14",
    "tailwindcss": "4.0.9",
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  }
}
