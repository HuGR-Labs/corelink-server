{
  "name": "@corelink/admin-ui",
  "version": "0.1.0",
  "private": true,
  "description": "CoreLink Admin UI \u2014 Next.js 15 + Clerk + hardened CSP + i18n (foundation per WI-S16-001).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --reporter=verbose",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps",
    "e2e:list": "playwright test --list",
    "e2e:tests": "playwright test --config=playwright.tests.config.ts",
    "e2e:tests:list": "playwright test --config=playwright.tests.config.ts --list",
    "e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "e2e:prod:list": "playwright test --config=playwright.prod.config.ts --list",
    "lhci": "lhci autorun --config=./lighthouserc.cjs",
    "cf:build": "opennextjs-cloudflare build && node scripts/strip-client-sourcemaps.mjs",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.69.0",
    "@stripe/stripe-js": "^9.12.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "next": "16.2.12",
    "next-intl": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "swr": "^2.4.2",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^11.0.0",
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@vitejs/plugin-react": "6.0.4",
    "vite": "^8.1.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "10.5.4",
    "axe-core": "^4.12.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "happy-dom": "^20.11.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "@opennextjs/cloudflare": "^1.19.11"
  }
}
