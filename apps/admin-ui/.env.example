# CoreLink Admin UI — Environment Variables (WI-S16-001 foundation)
# Copy to .env.local for local dev. NEVER commit .env.local.

# --- Clerk auth (S-03 cycle 9 SEAL reuse) ---
# Publishable key is exposed to the browser (client SDK).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Secret key is server-only. Never expose to client.
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Optional: Clerk JWT template name for PAT-issuing flow (full impl in WI-S16-002).
CLERK_JWT_TEMPLATE_PAT=

# --- CoreLink API endpoint ---
# Public base URL of the CoreLink API the UI talks to.
NEXT_PUBLIC_CORELINK_API_URL=https://api.corelink.dev

# --- CSP report forwarding ---
# Where CSP violation reports are POSTed (server-side from /api/csp-report).
# Defaults to ${NEXT_PUBLIC_CORELINK_API_URL}/v1/csp-violations if unset.
CSP_REPORT_ENDPOINT=

# --- Build metadata (injected by CI; safe to leave blank locally) ---
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_COMMIT=local
