# Docusaurus 3 + pnpm interaction fix (S-18 round-1 P0 remediation).
#
# Docusaurus's SSG node-require path (`ssgNodeRequire`) re-resolves webpack
# aliases like `@theme/*` against the real filesystem at render time. Under
# pnpm's default isolated `node_modules/.pnpm/...` symlinked layout combined
# with Node 22 ESM strict resolution, `@theme/prism-include-languages` (and
# similar theme-internal aliases) cannot be located, breaking `pnpm build`.
#
# Switching this workspace to hoisted node_modules layout flattens Docusaurus
# deps to a single `apps/docs/node_modules/` tree, which matches the npm/yarn
# layout that upstream Docusaurus tests against.
#
# Scope: this `.npmrc` applies ONLY to `apps/docs`. The rest of the monorepo
# (apps/admin-ui, root) retains pnpm's default isolated mode.
node-linker=hoisted
public-hoist-pattern[]=@docusaurus/*
public-hoist-pattern[]=@theme/*
public-hoist-pattern[]=@mdx-js/*
