{
  "name": "@corelink/docs",
  "version": "0.1.0",
  "private": true,
  "description": "CoreLink public documentation site (Docusaurus 3 + Diátaxis + 3-locale i18n + custom domain docs.corelink.humangr.com). WI-S18-001 foundation + WI-S18-002 REAPI/tutorials + WI-S18-003 SDK guides + WI-S18-004 compliance/security/pricing + WI-S18-005 ship gate.",
  "type": "module",
  "scripts": {
    "dev": "docusaurus start",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "docs:gen": "tsx scripts/gen-reapi-docs.ts",
    "docs:gen:check": "tsx scripts/gen-reapi-docs.ts --check",
    "i18n-coverage": "tsx scripts/i18n-coverage.ts",
    "i18n-coverage:report": "tsx scripts/i18n-coverage-report.ts",
    "i18n:mt-stub": "tsx scripts/mt-stub-seed.ts",
    "i18n:export": "tsx scripts/export-xliff.ts",
    "i18n:import": "tsx scripts/import-xliff.ts",
    "i18n:qc": "tsx scripts/translation-quality-check.ts",
    "a11y-audit": "bash scripts/a11y-audit.sh",
    "a11y-audit:baseline": "bash scripts/a11y-audit.sh --baseline",
    "a11y-audit:diff": "bash scripts/a11y-audit.sh --against=baseline",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "vale": "vale --config=.vale.ini docs",
    "broken-links": "lychee --config lychee.toml ./build || true"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.3",
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.2",
    "gray-matter": "^4.0.3",
    "protobufjs": "^8.4.2",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  }
}
