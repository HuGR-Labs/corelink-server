{
  "name": "@corelink/client",
  "version": "0.1.0",
  "description": "Official CoreLink JavaScript/TypeScript SDK — content-addressable cache (CAS) + Action Cache (AC) client with default-on BLAKE3 verify.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "corelink",
    "cache",
    "content-addressable",
    "cas",
    "blake3",
    "action-cache",
    "reapi"
  ],
  "publishConfig": {
    "access": "public"
  }
}
