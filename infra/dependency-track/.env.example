# Dependency-Track deployment secrets template (WI-S12-005).
# Copy to .env and fill values. NEVER commit .env to git.

# Neon Postgres connection string (small tier, HA, PITR enabled).
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
NEON_POSTGRES_URL=postgresql://dt_user:CHANGEME@ep-xxx.us-east-2.aws.neon.tech/dt_db?sslmode=require

# DT webhook HMAC shared secret (X-Hub-Signature-256).
# Rotate quarterly per CTRL-AUTH-014.
DT_WEBHOOK_SECRET=CHANGEME_rotate_quarterly

# NVD API key (free tier, 50 req/30s; required for NVD sync).
# Register: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=CHANGEME

# Slack webhook URL for #supply-chain-cve-alerts.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGEME

# PagerDuty integration key (Events API v2).
PAGERDUTY_ROUTING_KEY=CHANGEME

# SendGrid API key (free tier, 100 emails/day).
SENDGRID_API_KEY=CHANGEME

# Email recipient for CVE alerts.
SECURITY_EMAIL=corelinksec@humangr.com
