    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS by plan tier",
      "description": "Threshold/alert: n/a",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (plan) (rate(corelink_cas_requests_total{env=\"$env\", region=~\"$region\"}[1m])) + sum by (plan) (rate(corelink_ac_requests_total{env=\"$env\", region=~\"$region\"}[1m]))",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
