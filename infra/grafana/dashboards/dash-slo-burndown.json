    {
      "id": 1,
      "type": "stat",
      "title": "SLO Catalog \u2014 current burn (all SLOs)",
      "description": "Threshold/alert: red \u2265 6 (SEV-2 multi-burn); orange \u2265 1; green < 1",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "corelink_slo_burn_rate{slo=~\"$slo\", window=\"1h\", env=\"$env\"}",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
