      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (region) (corelink_storage_used_bytes{env=\"$env\"})",
          "legendFormat": "__auto"
        }
