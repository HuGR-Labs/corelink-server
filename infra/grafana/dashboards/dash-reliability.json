      "id": 1,
      "type": "stat",
      "title": "Uptime % (30d) per SLO",
      "description": "Threshold/alert: red < 0.995; orange < 0.999; green \u2265 0.999",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (slo) (increase(corelink_slo_good_total{env=\"$env\"}[$window])) / sum by (slo) (increase(corelink_slo_total_total{env=\"$env\"}[$window]))",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
