# Copy to `.env` (gitignored) and fill in.
#
# Registration token from: repo Settings > Actions > Runners > "New self-hosted
# runner" > Linux/x64. Tokens are short-lived (~1h) and one-time — the runner
# stays registered after first start; you only need a fresh token to (re)register.
RUNNER_TOKEN=PASTE_REGISTRATION_TOKEN_HERE
