{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "CoreLink Execute Action (S-17) datasource (Prometheus / VictoriaMetrics / Grafana Cloud Mimir tenant)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "DASH-EXEC",
  "title": "CoreLink — Execute Action (DASH-EXEC)",
  "description": "WI-S09-005 §6.1 canonical observability_model.md §10 Nível-3 Execute Action dashboard. Tracks REAPI v2 ExecuteRequest active slots, queue depth, durations, exit codes per S-17 (future). Empty staging metrics until S-17 ships; dashboard scaffolds the contract.",
  "tags": ["corelink", "exec", "reapi", "s09", "high-risk", "sota"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "name": "lastUpdated",
        "datasource": "$DS_PROMETHEUS",
        "enable": false,
        "iconColor": "blue"
      }
    ],
    "lastUpdated": "2026-05-03T00:00:00Z",
    "cardinality_budget_used": "4500/100000"
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant_tier",
        "type": "custom",
        "label": "Tenant Tier",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "all", "selected": true },
          { "text": "Free", "value": "free" },
          { "text": "Solo", "value": "solo" },
          { "text": "Team", "value": "team" },
          { "text": "Business", "value": "business" },
          { "text": "Enterprise", "value": "enterprise" }
        ],
        "query": "all,free,solo,team,business,enterprise"
      },
      {
        "name": "tenant",
        "type": "query",
        "label": "Tenant (AdminCtx only)",
        "datasource": "$DS_PROMETHEUS",
        "query": "label_values(corelink_exec_action_total, tenant_id)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "all", "value": "all" }
      },
      {
        "name": "region",
        "type": "custom",
        "label": "Region",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "all", "selected": true },
          { "text": "SAM", "value": "sam" },
          { "text": "IAD", "value": "iad" },
          { "text": "LHR", "value": "lhr" },
          { "text": "NRT", "value": "nrt" },
          { "text": "SYD", "value": "syd" }
        ],
        "query": "all,sam,iad,lhr,nrt,syd"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active execution slots per region — capacity gauge",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 1 — concurrent active ExecuteAction sessions per region. Saturation signal for compute capacity planning.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (region) (corelink_exec_active_slots{region=~\"$region\"})",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Queue depth per region — saturation signal (USE.S)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 2 — pending ExecuteAction queue depth per region. Sustained > 100 = SEV-3 capacity ticket; queue Little's-Law p99 wait time bound.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (region) (corelink_exec_queue_depth{region=~\"$region\"})",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Execution duration p50 / p95 / p99 — exemplar deep-link to Tempo",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 3 + CAP-OBS-009 exemplar inheritance. ExecuteAction wallclock duration from request to ActionResult; click exemplar → Tempo trace.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(corelink_exec_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(corelink_exec_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(corelink_exec_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Exit code distribution — success (0) vs failure (non-zero)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 4 — ExecuteAction exit code RED.E breakdown. Sustained non-zero rate > 5% = SEV-3 (regressed customer build).",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum by (exit_code_class) (rate(corelink_exec_action_total[5m]))",
          "legendFormat": "{{exit_code_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Action cache miss → execute fall-through rate",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 5 — REAPI v2 ExecuteAction triggered after AC miss. High rate = AC hit ratio degradation; cross-link DASH-AC.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(corelink_exec_ac_miss_fallthrough_total[5m]))",
          "legendFormat": "AC miss fallthrough",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Per-tier active slots — fairness check",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 6 — per-tier capacity allocation snapshot. Free + Solo throttled vs Business + Enterprise priority lanes.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (tenant_tier) (corelink_exec_active_slots{tenant_tier=~\"$tenant_tier\"})",
          "legendFormat": "{{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Worker resource utilization (CPU + memory + egress) per slot",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 7 — per-slot resource usage histograms. Resource regression detection vs baseline.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, resource) (rate(corelink_exec_resource_utilization_pct_bucket[5m])))",
          "legendFormat": "{{resource}} p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cancellation rate (client-initiated + timeout)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 8 — REAPI v2 CancelOperation rate; sustained timeout cancellation rate > 1% = SEV-3 (latency regression).",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(corelink_exec_cancellation_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Embedded CHAOS panels — chaos test status (S-17 inheritance)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 9 + Lote 10.9-quaters NEW-P0-1 CHAOS→SLO-CATALOG cross-link. S-17 chaos test last run status; PASS = 1 / FAIL = 0.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "PASS", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "FAIL", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "max(corelink_chaos_test_pass{suite=\"exec\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "INV-EXEC-IDEMPOTENT canary — duplicate-action detection (MUST = 0)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 10 + INV-EXEC-IDEMPOTENT canary. Same action_digest executed concurrently > 1 = race; > 0 sustained = SEV-2.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(corelink_exec_idempotency_violation_total[5m]))",
          "legendFormat": "idempotency violations (5m)",
          "refId": "A"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Spec — WI-S09-005",
      "url": "../../specs/04_sprints/S09/work_items/WI-S09-005-12-grafana-dashboards-as-code.md",
      "type": "link",
      "icon": "doc"
    },
    {
      "title": "DASH-AC (Action Cache cross-link)",
      "url": "/d/DASH-AC",
      "type": "link",
      "icon": "dashboard"
    }
  ]
}
