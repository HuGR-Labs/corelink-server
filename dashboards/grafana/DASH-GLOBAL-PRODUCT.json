{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "CoreLink global business pulse datasource (Prometheus / VictoriaMetrics / Grafana Cloud Mimir tenant)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "DASH-GLOBAL-PRODUCT",
  "title": "CoreLink — Global Product (DASH-GLOBAL-PRODUCT)",
  "description": "WI-S09-005 §6.1 canonical observability_model.md §10 Nível-3 business pulse dashboard. Companion to DASH-GLOBAL-HEALTH (operational). Tracks tenant adoption, cache hit ratio, storage used, MRR proxy, churn signals. Product + Compliance personas. AdminCtx RBAC enforces per-tenant drill-down ACL.",
  "tags": ["corelink", "global-product", "business", "s09", "high-risk", "sota"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "annotations": {
    "list": [
      {
        "name": "lastUpdated",
        "datasource": "$DS_PROMETHEUS",
        "enable": false,
        "iconColor": "blue"
      }
    ],
    "lastUpdated": "2026-05-03T00:00:00Z",
    "cardinality_budget_used": "3200/100000"
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant_tier",
        "type": "custom",
        "label": "Tenant Tier",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "all", "selected": true },
          { "text": "Free", "value": "free" },
          { "text": "Solo", "value": "solo" },
          { "text": "Team", "value": "team" },
          { "text": "Business", "value": "business" },
          { "text": "Enterprise", "value": "enterprise" }
        ],
        "query": "all,free,solo,team,business,enterprise"
      },
      {
        "name": "tenant",
        "type": "query",
        "label": "Tenant (AdminCtx only)",
        "datasource": "$DS_PROMETHEUS",
        "query": "label_values(corelink_billing_events_emitted_total, tenant_id)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "all", "value": "all" }
      },
      {
        "name": "region",
        "type": "custom",
        "label": "Region",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "all", "selected": true },
          { "text": "SAM", "value": "sam" },
          { "text": "IAD", "value": "iad" },
          { "text": "LHR", "value": "lhr" },
          { "text": "NRT", "value": "nrt" },
          { "text": "SYD", "value": "syd" }
        ],
        "query": "all,sam,iad,lhr,nrt,syd"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active tenants (MAU rolling 30d) per tier",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 1 — top-level adoption metric. count distinct tenant_id with ≥ 1 RED triple datapoint last 30d per tier. AdminCtx required for per-tenant drill-down.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "count by (tenant_tier) (sum by (tenant_id, tenant_tier) (rate(corelink_cas_put_requests_total{tenant_tier=~\"$tenant_tier\"}[30d]) > 0))",
          "legendFormat": "{{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tenant growth trend (week-over-week %)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 2 — WoW tenant adoption rate signal for go-to-market input. SOTA target 10% WoW sustained in early-stage growth phase.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "100 * (count(sum by (tenant_id) (rate(corelink_cas_put_requests_total[7d]) > 0)) - count(sum by (tenant_id) (rate(corelink_cas_put_requests_total[7d] offset 7d) > 0))) / count(sum by (tenant_id) (rate(corelink_cas_put_requests_total[7d] offset 7d) > 0))",
          "legendFormat": "WoW % growth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cache hit ratio (CAS + AC combined) per tier — business signal",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 3 — customer-facing business metric (S-16 customer dashboard mirrors). SOTA baseline ≥ 70% staging Bazel synthetic workload. Drop > 50% sustained 30min = SEV-1.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.7 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg by (tenant_tier) (corelink_cache_hit_ratio{type=~\"cas|ac\", tenant_tier=~\"$tenant_tier\"})",
          "legendFormat": "{{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Bytes deduplicated (rolling 30d cumulative) — customer cost-savings proxy",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 4 + S-07 dedup inheritance. Cumulative bytes saved via dedup per tier; customer marketing claim defensibility. NativeLink ~2.1× / BuildBuddy ~2.8× SOTA target.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "sum by (tenant_tier) (increase(corelink_dedup_bytes_saved_total{tenant_tier=~\"$tenant_tier\"}[30d]))",
          "legendFormat": "{{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total storage used per tier (R2 bytes) — capacity + billing input",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 5 — storage gauge per tier; quota utilization context for DASH-COST cross-link. Sustained growth slope feeds capacity planning.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "sum by (tenant_tier) (corelink_storage_bytes_used{tenant_tier=~\"$tenant_tier\"})",
          "legendFormat": "{{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "MRR proxy per tier — billing events × tier price (S-10 inheritance)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 6 + S-10 billing inheritance. Monthly recurring revenue proxy: count of paid tenants × tier MRR price; AdminCtx + Compliance role only.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "expr": "sum by (tenant_tier) (corelink_billing_mrr_proxy_usd{tenant_tier=~\"$tenant_tier\"})",
          "legendFormat": "{{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Churn signal — tenants inactive > 14d (rolling)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 7 — churn early-warning signal. count of tenants with last_activity > 14d ago; product retention input.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "count by (tenant_tier) (corelink_tenant_last_activity_days{tenant_tier=~\"$tenant_tier\"} > 14)",
          "legendFormat": "{{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "REAPI conformance status — production telemetry (signal of customer integration health)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 8 + WI-S04-006 inheritance. Bazelbuild/remote-apis test suite pinned; PASS = 1 / FAIL = 0. 100% pass non-negotiable.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "PASS (100%)", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "FAIL", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "corelink_reapi_conformance_pass",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Tier distribution pie — adoption mix",
      "type": "piechart",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 9 — adoption mix snapshot per 5-tier canonical (Lote 10.7bis P0-7). Free→Enterprise distribution.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 18 },
      "targets": [
        {
          "expr": "count by (tenant_tier) (sum by (tenant_id, tenant_tier) (rate(corelink_cas_put_requests_total[30d]) > 0))",
          "legendFormat": "{{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Customer SLA breach count (rolling 30d) — credit eligibility trigger",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 10 + sprint contract §6 DoD breach tracking. SLA credit eligibility per S-13 admin plane (deferred). Rolling 30d window per SLO-CATALOG SLI.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (sli) (increase(corelink_slo_breach_total{sli=~\"availability|latency_p99|durability\"}[30d]))",
          "legendFormat": "{{sli}} (30d breach)",
          "refId": "A"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Spec — WI-S09-005",
      "url": "../../specs/04_sprints/_sealed/S09/work_items/WI-S09-005-12-grafana-dashboards-as-code.md",
      "type": "link",
      "icon": "doc"
    },
    {
      "title": "DASH-GLOBAL-HEALTH (operational companion)",
      "url": "/d/DASH-GLOBAL-HEALTH",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "DASH-COST (cost detail)",
      "url": "/d/DASH-COST",
      "type": "link",
      "icon": "dashboard"
    }
  ]
}
