{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "CoreLink API SLO datasource (Prometheus / VictoriaMetrics / Grafana Cloud Mimir tenant)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "DASH-SLO-API",
  "title": "CoreLink — API Request SLO (DASH-SLO-API)",
  "description": "WP-6.1 Phase 1 observability surface. API request SLO dashboard: p50/p95/p99 latency per endpoint, error rate by endpoint, per-tenant top-10 talkers breakdown. Metric names verified against crates/corelink-analytics/src/canonical.rs RedMetricKind::as_str() — all 15 canonical RED+USE names used exclusively (no invented metrics).",
  "tags": ["corelink", "slo", "api", "latency", "error-rate", "per-tenant", "sota"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "name": "lastUpdated",
        "datasource": "$DS_PROMETHEUS",
        "enable": false,
        "iconColor": "blue"
      },
      {
        "name": "API SLO breach incidents",
        "datasource": "$DS_PROMETHEUS",
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertname=~\"API.*|CAS.*|AC.*\", severity=~\"sev0|sev1|sev2\"}"
      }
    ],
    "lastUpdated": "2026-05-27T00:00:00Z",
    "cardinality_budget_used": "8200/100000"
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant_tier",
        "type": "custom",
        "label": "Tenant Tier",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "all", "selected": true },
          { "text": "Free", "value": "free" },
          { "text": "Solo", "value": "solo" },
          { "text": "Team", "value": "team" },
          { "text": "Business", "value": "business" },
          { "text": "Enterprise", "value": "enterprise" }
        ],
        "query": "all,free,solo,team,business,enterprise"
      },
      {
        "name": "tenant",
        "type": "query",
        "label": "Tenant (AdminCtx only — top 10 talkers)",
        "datasource": "$DS_PROMETHEUS",
        "query": "label_values(corelink_cas_put_requests_total, tenant_id)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "all", "value": "all" }
      },
      {
        "name": "region",
        "type": "custom",
        "label": "Region",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "all", "selected": true },
          { "text": "SAM", "value": "sam" },
          { "text": "IAD", "value": "iad" },
          { "text": "LHR", "value": "lhr" },
          { "text": "NRT", "value": "nrt" },
          { "text": "SYD", "value": "syd" }
        ],
        "query": "all,sam,iad,lhr,nrt,syd"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CAS PUT — p50/p95/p99 latency (SLO: p99 ≤ 500ms)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WP-6.1 panel 1 — CAS PUT duration distribution. RedMetricKind::CasPutDurationSeconds (corelink_cas_put_duration_seconds histogram). SLO: p99 ≤ 500ms sustained 30d per SLO-CATALOG. Exemplar deep-link to Tempo (CAP-OBS-009).",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.25 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, region) (rate(corelink_cas_put_duration_seconds_bucket{region=~\"$region\"}[5m])))",
          "legendFormat": "p50 {{region}}",
          "refId": "A",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, region) (rate(corelink_cas_put_duration_seconds_bucket{region=~\"$region\"}[5m])))",
          "legendFormat": "p95 {{region}}",
          "refId": "B",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, region) (rate(corelink_cas_put_duration_seconds_bucket{region=~\"$region\"}[5m])))",
          "legendFormat": "p99 {{region}}",
          "refId": "C",
          "exemplar": true
        }
      ]
    },
    {
      "id": 2,
      "title": "CAS PUT — error rate by result (RED.E) — SLO: error rate < 0.1%",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WP-6.1 panel 2 — CAS PUT error rate per region+result. RedMetricKind::CasPutRequestsTotal (corelink_cas_put_requests_total{result}). SLO: error rate < 0.1% sustained; > 0.1% = SEV-2 ticket; > 1% = SEV-1 page.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (region) (rate(corelink_cas_put_requests_total{result!=\"ok\", region=~\"$region\"}[5m])) / sum by (region) (rate(corelink_cas_put_requests_total{region=~\"$region\"}[5m]))",
          "legendFormat": "error rate {{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "AC Lookup — hit ratio per tenant tier (SLO: cache hit ≥ 80% for warm tenants)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WP-6.1 panel 3 — ActionCache lookup hit vs miss ratio per tier. RedMetricKind::AcLookupRequestsTotal (corelink_ac_lookup_requests_total{hit_miss}). SLO: hit ratio ≥ 80% for Business/Enterprise tenants.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (tenant_tier) (rate(corelink_ac_lookup_requests_total{hit_miss=\"hit\", tenant_tier=~\"$tenant_tier\", region=~\"$region\"}[5m])) / sum by (tenant_tier) (rate(corelink_ac_lookup_requests_total{tenant_tier=~\"$tenant_tier\", region=~\"$region\"}[5m]))",
          "legendFormat": "hit ratio {{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Rate-limit reject rate by tier — fairness signal (SLO: Enterprise < 0.01% rejects)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WP-6.1 panel 4 — rate-limit reject rate per tier+layer. RedMetricKind::RateLimitRejectsTotal (corelink_rate_limit_rejects_total{layer, tenant_tier, reason}). Business/Enterprise sustained reject rate > 0.01% = SEV-3 capacity ticket.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (tenant_tier, reason) (rate(corelink_rate_limit_rejects_total{tenant_tier=~\"$tenant_tier\", region=~\"$region\"}[5m]))",
          "legendFormat": "{{tenant_tier}} / {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Top-10 tenants by CAS PUT request volume (per-tenant breakdown — AdminCtx only)",
      "type": "table",
      "datasource": "$DS_PROMETHEUS",
      "description": "WP-6.1 panel 5 — per-tenant CAS PUT request rate, top 10 talkers. RedMetricKind::CasPutRequestsTotal (corelink_cas_put_requests_total{tenant_id}). R15 per-tenant: AdminCtx-gated; pseudonymous tenant_id only (INV-OBS-NO-PII).",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (tenant_id) (rate(corelink_cas_put_requests_total{tenant_tier=~\"$tenant_tier\", region=~\"$region\"}[5m])))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "footer": {
          "show": false
        },
        "sortBy": [{ "displayName": "Value", "desc": true }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "tenant_id": "Tenant ID (pseudonymous)",
              "Value": "CAS PUT req/s"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Top-10 tenants by AC Lookup volume — cache hit/miss breakdown",
      "type": "table",
      "datasource": "$DS_PROMETHEUS",
      "description": "WP-6.1 panel 6 — per-tenant AC lookup rate top-10, with hit/miss split. RedMetricKind::AcLookupRequestsTotal. R15 per-tenant AdminCtx. Helps identify tenants that under-utilise the cache (no warmed AC).",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (tenant_id, hit_miss) (rate(corelink_ac_lookup_requests_total{tenant_tier=~\"$tenant_tier\", region=~\"$region\"}[5m])))",
          "legendFormat": "{{tenant_id}} / {{hit_miss}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "footer": {
          "show": false
        },
        "sortBy": [{ "displayName": "Value", "desc": true }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "tenant_id": "Tenant ID (pseudonymous)",
              "hit_miss": "Hit/Miss",
              "Value": "AC lookup req/s"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "CAS GET — bytes egress per region (USE.U throughput signal)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WP-6.1 panel 7 — CAS GET egress bytes per region. RedMetricKind::CasGetBytesTotal (corelink_cas_get_bytes_total{tenant_tier, region}). Capacity planning: R2 egress cost signal + SLO bandwidth headroom.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        }
      },
      "targets": [
        {
          "expr": "sum by (region) (rate(corelink_cas_get_bytes_total{tenant_tier=~\"$tenant_tier\", region=~\"$region\"}[5m]))",
          "legendFormat": "egress {{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "CF Worker CPU time p99 per region — USE.U compute headroom",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WP-6.1 panel 8 — CF Worker CPU time per invocation (microseconds). RedMetricKind::CfCpuTimeUs (corelink_cf_cpu_time_us{region}). Gauge. CF Workers CPU limit: 30ms per invocation; sustained > 25ms = SEV-3 capacity ticket.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 20000 },
              { "color": "red", "value": 25000 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max by (region) (corelink_cf_cpu_time_us{region=~\"$region\"})",
          "legendFormat": "CPU time p99 {{region}}",
          "refId": "A"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "WP-6.1 spec — 2026-05-27-15-agent-dispatch-matrix.md §2",
      "url": "../../specs/_audits/2026-05-27-15-agent-dispatch-matrix.md",
      "type": "link",
      "icon": "doc"
    },
    {
      "title": "DASH-CAS (CAS hot path detail)",
      "url": "/d/DASH-CAS",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "DASH-SLO-CATALOG (multi-burn-rate alerts)",
      "url": "/d/DASH-SLO-CATALOG",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "DASH-AC (ActionCache detail)",
      "url": "/d/DASH-AC",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "DASH-RATE (Rate-limit detail)",
      "url": "/d/DASH-RATE",
      "type": "link",
      "icon": "dashboard"
    }
  ]
}
