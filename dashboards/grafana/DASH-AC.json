{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "CoreLink Action Cache metrics datasource (Prometheus / VictoriaMetrics / Grafana Cloud)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "DASH-AC",
  "title": "CoreLink — Action Cache (DASH-AC)",
  "description": "WI-S04-006 §6.1.2 canonical Action Cache dashboard. 8 panels per WI body §6.1.2: cache hit ratio (business metric); latency p99 GET/UPDATE warm/cold; tenant isolation alert; sig invalid rate; TTL eviction rate; negative cache rates; REAPI conformance status; cost per-op tracker.",
  "tags": ["corelink", "action-cache", "s04", "s09", "high-risk", "ship-gate", "sota"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant_tier",
        "type": "custom",
        "label": "Tenant Tier",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "Free", "value": "free" },
          { "text": "Solo", "value": "solo" },
          { "text": "Team", "value": "team" },
          { "text": "Business", "value": "business" },
          { "text": "Enterprise", "value": "enterprise" }
        ],
        "query": "free,solo,team,business,enterprise"
      },
      {
        "name": "region",
        "type": "custom",
        "label": "Region",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "SAM", "value": "sam" },
          { "text": "IAD", "value": "iad" },
          { "text": "LHR", "value": "lhr" },
          { "text": "NRT", "value": "nrt" },
          { "text": "SYD", "value": "syd" }
        ],
        "query": "sam,iad,lhr,nrt,syd"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cache Hit Ratio — business metric (per tenant_tier × region)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1.3 — customer-visible business metric. SLO baseline ≥ 70% staging Bazel synthetic workload. Customer dashboard S-16 mirrors this panel. Drop > 50% sustained 30 min = P0 incident; reset 72h SLO clock.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.7 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "corelink_cache_hit_ratio{type=\"ac\", tenant_tier=~\"$tenant_tier\", region=~\"$region\"}",
          "legendFormat": "{{tenant_tier}} / {{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p99 — GET / UPDATE warm + cold per region",
      "type": "heatmap",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1.2 + spec contract §9 — SLO-LAT-AC-HIT p99 ≤ 150 ms warm; UPDATE p99 ≤ 300 ms; cold ≤ 280 ms. Sustained 72h staging.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, op, warmth, region) (rate(corelink_ac_handler_duration_seconds_bucket{region=~\"$region\"}[5m])))",
          "legendFormat": "{{op}} / {{warmth}} / {{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tenant Isolation Alert — cross-tenant requests (must be 0)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1.2 — INV-AC-TENANT-SCOPED: any cross-tenant request detected = SEV-0 incident. Non-zero value triggers RB-FM-303 immediately + clock reset on the 72h SLO. Property test 100k iter at PR (`prop_ac_full_stack_tenant_isolation_100k`) confirms the in-process invariant; this panel surfaces the staging counter.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(corelink_ac_cross_tenant_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Sig Invalid Rate — alert ≥ 5/h",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1.2 — `corelink.ac.update.sig_invalid` + `corelink.ac.get.sig_invalid` events. Tampering signal; sustained > 5/h fires SEV-1.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (op) (rate(corelink_ac_sig_invalid_total[1h])) * 3600",
          "legendFormat": "{{op}} sig_invalid/h",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "TTL Eviction Rate — per region",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI-S04-005 cron worker eviction signal. Sustained spike = `RB-FM-AC-TTL-STORM` trigger. Stalled (zero rate w/ row-ceiling hit) = `RB-FM-AC-TTL-DRIFT` trigger.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (region) (rate(corelink_ac_ttl_rows_evicted_total{region=~\"$region\"}[5m]))",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Negative Cache — hit / populate / invalidate (per region)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1.2 — neg cache cohort hot path counts. Per WI-S02-005 60s TTL canonical for AC.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "sum by (op, region) (rate(corelink_ac_neg_cache_total{region=~\"$region\"}[5m]))",
          "legendFormat": "{{op}} / {{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "REAPI v2 Conformance Status — last run + result",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1.1 — bazelbuild/remote-apis test suite pinned commit (ADR-0036). 100% pass non-negotiable for ship; PR red on regression.",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "PASS (100%)", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "FAIL", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "corelink_reapi_conformance_pass",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cost per-op tracker — alert if > 110% of target",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1.2 — cost regression gate. Targets: verify $0.000002 / sign $0.000001 / GET warm $0.000005 / UPDATE $0.000015 / eviction $0.000003. ±10% tolerance per WI Quality Standards 14.s04.006.7.",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 110 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "corelink_ac_cost_per_op_usd{op=~\"verify|sign|get_warm|update|eviction\"}",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "AC SEV-1 incidents",
        "datasource": "$DS_PROMETHEUS",
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertname=~\"AC.*\", severity=~\"sev1|sev0\"}"
      },
      {
        "name": "lastUpdated",
        "datasource": "$DS_PROMETHEUS",
        "enable": false,
        "iconColor": "blue"
      }
    ],
    "lastUpdated": "2026-05-03T00:00:00Z",
    "cardinality_budget_used": "4200/100000"
  },
  "links": [
    {
      "title": "Spec — WI-S04-006",
      "url": "../../specs/04_sprints/_sealed/S04/work_items/WI-S04-006-reapi-conformance-prr-ship-gate.md",
