      "icon": "doc"
    },
    {
      "title": "Runbook — RB-FM-303 (AC cross-tenant)",
      "url": "../../specs/05_quality/runbooks/RB-FM-303-ac-cross-tenant.md",
      "type": "link",
      "icon": "doc"
    }
  ]
}
