{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "CoreLink CAS hot path datasource (Prometheus / VictoriaMetrics / Grafana Cloud Mimir tenant)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "DASH-CAS",
  "title": "CoreLink — Content-Addressable Storage (DASH-CAS)",
  "description": "WI-S09-005 §6.1 canonical observability_model.md §10 Nível-3 CAS hot path dashboard. Embedded dedup panels from S-07 inheritance (DEDUP→CAS refactor per Lote 10.9-quaters NEW-P0-1 corrected). PUT/GET p50/p95/p99 + bytes throughput + error rate per region + cardinality budget annotation + exemplar deep-link to Tempo (CAP-OBS-009).",
  "tags": ["corelink", "cas", "dedup", "s09", "high-risk", "sota", "ship-gate"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "name": "lastUpdated",
        "datasource": "$DS_PROMETHEUS",
        "enable": false,
        "iconColor": "blue"
      },
      {
        "name": "CAS SEV-1 incidents",
        "datasource": "$DS_PROMETHEUS",
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertname=~\"CAS.*\", severity=~\"sev0|sev1\"}"
      }
    ],
    "lastUpdated": "2026-05-03T00:00:00Z",
    "cardinality_budget_used": "12500/100000"
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant_tier",
        "type": "custom",
        "label": "Tenant Tier",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "all", "selected": true },
          { "text": "Free", "value": "free" },
          { "text": "Solo", "value": "solo" },
          { "text": "Team", "value": "team" },
          { "text": "Business", "value": "business" },
          { "text": "Enterprise", "value": "enterprise" }
        ],
        "query": "all,free,solo,team,business,enterprise"
      },
      {
        "name": "tenant",
        "type": "query",
        "label": "Tenant (AdminCtx only)",
        "datasource": "$DS_PROMETHEUS",
        "query": "label_values(corelink_cas_put_requests_total, tenant_id)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "all", "value": "all" }
      },
      {
        "name": "region",
        "type": "custom",
        "label": "Region",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "all", "selected": true },
          { "text": "SAM", "value": "sam" },
          { "text": "IAD", "value": "iad" },
          { "text": "LHR", "value": "lhr" },
          { "text": "NRT", "value": "nrt" },
          { "text": "SYD", "value": "syd" }
        ],
        "query": "all,sam,iad,lhr,nrt,syd"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CAS PUT — request rate per region (RED.R)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 1 — CAS PUT throughput per region. Capacity planning input + traffic anomaly detection.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum by (region) (rate(corelink_cas_put_requests_total{region=~\"$region\", tenant_tier=~\"$tenant_tier\"}[5m]))",
          "legendFormat": "PUT {{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "CAS GET — request rate per region (RED.R) + warm/cold split",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 2 — CAS GET throughput per region with warm/cold cache split. Warm hit ratio = warm / (warm+cold); SLO target ≥ 70%.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum by (region, warmth) (rate(corelink_cas_get_requests_total{region=~\"$region\", tenant_tier=~\"$tenant_tier\"}[5m]))",
          "legendFormat": "GET {{warmth}} {{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "CAS PUT latency p50 / p95 / p99 — exemplar deep-link to Tempo (CAP-OBS-009)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 3 + CAP-OBS-009 exemplar inheritance from WI-S09-003. SLO-LAT-CAS-PUT p99 ≤ 200ms warm. Click exemplar dot → Tempo trace view.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(corelink_cas_put_duration_seconds_bucket{region=~\"$region\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(corelink_cas_put_duration_seconds_bucket{region=~\"$region\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(corelink_cas_put_duration_seconds_bucket{region=~\"$region\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "title": "CAS GET latency p50 / p95 / p99 (warm + cold) — exemplar deep-link to Tempo (CAP-OBS-009)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 4 + CAP-OBS-009 exemplar inheritance. SLO-LAT-CAS-GET-WARM p99 ≤ 100ms; SLO-LAT-CAS-GET-COLD p99 ≤ 500ms.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, warmth) (rate(corelink_cas_get_duration_seconds_bucket{region=~\"$region\"}[5m])))",
          "legendFormat": "p99 {{warmth}}",
          "refId": "A",
          "exemplar": true
        }
      ]
    },
    {
      "id": 5,
      "title": "CAS bytes throughput per region (PUT + GET; egress + ingress)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 5 — bytes throughput per region. R2 backend bandwidth utilization input.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "expr": "sum by (region, op) (rate(corelink_cas_bytes_total{region=~\"$region\"}[5m]))",
          "legendFormat": "{{op}} {{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "CAS error rate per region per status code",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 6 — RED.E breakdown per status code. SLO-AVAIL-CAS-PUT denominator excludes over-quota 429 per sprint contract §7.10.s08.1.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum by (region, status_code) (rate(corelink_cas_put_requests_total{result=~\"4xx|5xx\", region=~\"$region\"}[5m]))",
          "legendFormat": "PUT {{status_code}} {{region}}",
          "refId": "A"
        },
        {
          "expr": "sum by (region, status_code) (rate(corelink_cas_get_requests_total{result=~\"4xx|5xx\", region=~\"$region\"}[5m]))",
          "legendFormat": "GET {{status_code}} {{region}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Embedded DEDUP panels — dedup ratio per tier (S-07 inheritance)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 7 + Lote 10.9-quaters NEW-P0-1 DEDUP→CAS refactor + S-07 inheritance. Dedup ratio per tier; SOTA target NativeLink ~2.1× / BuildBuddy ~2.8×.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 1.5 },
              { "color": "green", "value": 2 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg by (tenant_tier) (corelink_dedup_ratio{tenant_tier=~\"$tenant_tier\"})",
          "legendFormat": "{{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Embedded DEDUP panels — bytes reclaimed last 30d (S-07 inheritance)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 8 + S-07 dedup inheritance. Cumulative bytes saved via dedup-on-write counter.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "sum by (tenant_tier) (increase(corelink_dedup_bytes_saved_total{tenant_tier=~\"$tenant_tier\"}[30d]))",
          "legendFormat": "{{tenant_tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "CAS hit ratio per tier × region (heatmap)",
      "type": "heatmap",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 9 — cache hit ratio per (tier, region) cartesian; warm hit ratio business signal.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "avg by (tenant_tier, region) (corelink_cache_hit_ratio{type=\"cas\", tenant_tier=~\"$tenant_tier\", region=~\"$region\"})",
          "legendFormat": "{{tenant_tier}} · {{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "INV-CAS-INTEGRITY canary — digest mismatch counter (MUST = 0; SEV-0)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 10 + INV-CAS-INTEGRITY canary (registry §3.2). SHA-256 digest mismatch on read = corruption signal; > 0 = SEV-0 PagerDuty page Architect + Security.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(corelink_cas_digest_mismatch_total[5m]))",
          "legendFormat": "digest mismatch (5m)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Per-metric cardinality budget utilization — corelink_cas_put_requests_total + corelink_cas_get_requests_total",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 11 + INV-OBS-CARDINALITY-BUDGET inheritance from WI-S09-001. Per-metric ≤ 20k cap; SEV-3 alert at 80%.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * corelink_analytics_cardinality_per_metric{metric=\"corelink_cas_put_requests_total\"} / 20000",
          "legendFormat": "PUT cardinality % cap",
          "refId": "A"
        },
        {
          "expr": "100 * corelink_analytics_cardinality_per_metric{metric=\"corelink_cas_get_requests_total\"} / 20000",
          "legendFormat": "GET cardinality % cap",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "title": "Multipart upload chunker p99 (S-MULTIPART inheritance)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 12 + DASH-MULTIPART legacy panel cross-link. Chunker session p99 latency for multipart PUTs (> 5 MiB blobs).",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(corelink_multipart_chunker_duration_seconds_bucket[5m])))",
          "legendFormat": "chunker p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "CAS cost per-op tracker (sprint contract §14.s09.7 cost regression gate)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 13 + sprint contract §14.s09.7 cost regression gate. CF Workers + R2 + D1 cost per op USD; ±10% tolerance baseline.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "expr": "corelink_cas_cost_per_op_usd{op=~\"put|get_warm|get_cold\"}",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "R2 backend availability gauge per region (1=up, 0=down)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 14 — R2 dependency health per region. Sustained 0 > 60s = SEV-1 RB-FM-160 trigger.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "min by (region) (corelink_r2_backend_health{region=~\"$region\"})",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Spec — WI-S09-005",
