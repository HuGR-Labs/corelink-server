    },
    {
      "title": "DASH-GLOBAL-PRODUCT (business pulse companion)",
      "url": "/d/DASH-GLOBAL-PRODUCT",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "DASH-SLO-CATALOG (SLO burn-rate detail)",
      "url": "/d/DASH-SLO-CATALOG",
      "type": "link",
      "icon": "dashboard"
    }
  ]
}
