{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "CoreLink SLO catalog (multi-burn-rate alerts + chaos test status) datasource (Prometheus / VictoriaMetrics / Grafana Cloud Mimir tenant)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "DASH-SLO-CATALOG",
  "title": "CoreLink — SLO Catalog (DASH-SLO-CATALOG)",
  "description": "WI-S09-005 §6.1 canonical observability_model.md §10 Nível-3 SLO catalog dashboard. Consolidated multi-burn-rate alerts per Google SRE Workbook §5; embedded chaos test status from S-17 inheritance (CHAOS→SLO-CATALOG refactor per Lote 10.9-quaters NEW-P0-1 corrected). SRE Lead + Architect + QA personas.",
  "tags": ["corelink", "slo", "burn-rate", "chaos", "s09", "high-risk", "sota"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "name": "lastUpdated",
        "datasource": "$DS_PROMETHEUS",
        "enable": false,
        "iconColor": "blue"
      },
      {
        "name": "SLO breach incidents",
        "datasource": "$DS_PROMETHEUS",
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertname=~\"SLO.*\", severity=~\"sev0|sev1|sev2\"}"
      }
    ],
    "lastUpdated": "2026-05-03T00:00:00Z",
    "cardinality_budget_used": "9200/100000"
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "sli",
        "type": "custom",
        "label": "SLI",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "all", "selected": true },
          { "text": "AVAIL-CAS-PUT", "value": "avail_cas_put" },
          { "text": "AVAIL-CAS-GET", "value": "avail_cas_get" },
          { "text": "AVAIL-AC", "value": "avail_ac" },
          { "text": "LAT-CAS-PUT", "value": "lat_cas_put" },
          { "text": "LAT-CAS-GET-WARM", "value": "lat_cas_get_warm" },
          { "text": "LAT-CAS-GET-COLD", "value": "lat_cas_get_cold" },
          { "text": "LAT-AC-HIT", "value": "lat_ac_hit" },
          { "text": "DURABILITY-CAS", "value": "durability_cas" },
          { "text": "FRESH-GC", "value": "fresh_gc" },
          { "text": "CORRECT-GC", "value": "correct_gc" }
        ],
        "query": "all,avail_cas_put,avail_cas_get,avail_ac,lat_cas_put,lat_cas_get_warm,lat_cas_get_cold,lat_ac_hit,durability_cas,fresh_gc,correct_gc"
      },
      {
        "name": "region",
        "type": "custom",
        "label": "Region",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "all", "selected": true },
          { "text": "SAM", "value": "sam" },
          { "text": "IAD", "value": "iad" },
          { "text": "LHR", "value": "lhr" },
          { "text": "NRT", "value": "nrt" },
          { "text": "SYD", "value": "syd" }
        ],
        "query": "all,sam,iad,lhr,nrt,syd"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Multi-burn-rate alert status — page (1h+5min) per SLI (Sloth-style)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 1 + WI-S09-006 multi-burn-rate alert + Google SRE Workbook §5. burn(1h) > 14.4 AND burn(5min) > 14.4 → page; status per SLI from SLO-CATALOG.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max by (sli) (corelink_slo_burn_rate_page_active{sli=~\"$sli\"})",
          "legendFormat": "{{sli}} page",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Multi-burn-rate alert status — ticket (6h+30min) per SLI",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 2 + WI-S09-006 multi-burn-rate. burn(6h) > 6 AND burn(30min) > 6 → ticket; status per SLI.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max by (sli) (corelink_slo_burn_rate_ticket_active{sli=~\"$sli\"})",
          "legendFormat": "{{sli}} ticket",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error budget burn rate per SLI — 30d window (target 1.0 = sustainable)",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 3 + Google SRE Workbook §5 burn rate. Sustained > 14.4 = SEV-1 page; > 6 = SEV-2 ticket.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "corelink_slo_burn_rate_30d{sli=~\"$sli\"}",
          "legendFormat": "{{sli}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Per-SLI compliance % (30d rolling) — target 99.9% / 99.95% per SLO-CATALOG",
      "type": "table",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 4 — compliance ratio per SLI; SLO-CATALOG canonical targets. SLA credit eligibility input.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "corelink_slo_compliance_ratio_30d{sli=~\"$sli\"}",
          "legendFormat": "{{sli}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error budget remaining per SLI (30d) — alert at < 10% remaining",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 5 — error budget remaining = (1 - actual_breach_ratio / target_breach_ratio); SEV-3 if < 10% remaining.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.1 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "corelink_slo_error_budget_remaining{sli=~\"$sli\"}",
          "legendFormat": "{{sli}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "promtool test rules status — 100% green canonical (sprint contract §6 DoD)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 6 + sprint contract §6 DoD promtool 100% green non-negotiable. CI gate per WI-S09-006.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "PASS", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "FAIL", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "min(corelink_promtool_rule_test_pass)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Embedded CHAOS panels — chaos test status per suite (S-17 inheritance)",
      "type": "table",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 7 + Lote 10.9-quaters NEW-P0-1 CHAOS→SLO-CATALOG embed + S-17 inheritance. Per-suite chaos test pass/fail; SOTA target ≥ 10 chaos suites HIGH_RISK.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "1": { "text": "PASS", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "FAIL", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "max by (suite) (corelink_chaos_test_pass)",
          "legendFormat": "{{suite}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Synthetic canary 3 regions sustained 72h gauge (1=clean, 0=gap detected)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 8 + sprint contract §6 DoD synthetic canary 24/7 sustained 72h sem gap. 0 = ship-block trigger.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "min(corelink_synthetic_canary_72h_clean)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "PagerDuty MTTA p99 (synthetic) — SLO ≤ 5min sustained 7d",
      "type": "timeseries",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 9 + sprint contract §7.10.s09.4. PagerDuty MTTA < 5min synthetic test sustained 7d; > 300s sustained = SEV-2.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 180 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(corelink_pagerduty_synthetic_ack_seconds_bucket[7d])))",
          "legendFormat": "MTTA p99 (7d)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Alert flapping detector — alerts firing > 3× per week (auto-quarantine signal)",
      "type": "table",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 10 + sprint contract §14.s09.2. Sustained > 3× per week sem root cause = auto-quarantine via PagerDuty API.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 26 },
      "targets": [
        {
          "expr": "topk(20, sum by (alertname) (changes(ALERTS{alertstate=\"firing\"}[7d])))",
          "legendFormat": "{{alertname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Runbook coverage — % SEV-1/2 alerts with runbook URL (sprint contract §14.s09.3)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 11 + sprint contract §14.s09.3 alert discipline. PR creating alert sem runbook URL = CI fail.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 100 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * corelink_alerts_with_runbook_count / on() group_left() corelink_alerts_total_count",
          "legendFormat": "% alerts with runbook",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "TLA+ verification status (4 specs canonical) — 30d sustained (sprint contract §6.s06)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 12 + sprint contract S-20 GA gate. 4 specs: tenant_isolation + gc_correctness + cas_integrity + audit_immutability. CI gate sustained 30d.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "max": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 2 },
              { "color": "green", "value": 4 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(corelink_tla_spec_verify_pass)",
          "legendFormat": "TLA+ specs verified",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Property test sustained — 100k nightly per HIGH_RISK SOTA bar (7d clean)",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 13 + sprint contract §14.s09.8 100k nightly per HIGH_RISK lane. Property tests must sustain 7d sem regression.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 38 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "GREEN 7d", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "REGRESSION", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "min(corelink_property_test_nightly_pass_7d)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Alert count drift detector (Lote 10.8-tris P1-NEW-1 discipline) — file count vs narrative",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 14 + Lote 10.8-tris P1-NEW-1 lesson. YAML rule count == narrative claim canonical. Sustained drift = SEV-3 + ADR.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 38 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(corelink_alert_count_drift_detected)",
          "legendFormat": "drift count",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Audit chain integrity rolling 7d (sprint contract §10.s09.8) — daily verify clean",
      "type": "stat",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 15 + sprint contract §10.s09.8 audit chain verify rolling 7d clean. WI-S09-004 inheritance.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 44 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "GREEN 7d", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "BREAK", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "min(corelink_audit_chain_verify_pass_7d)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "title": "PRR sign-off ship gate aggregate (per HIGH_RISK 11–13 sign-offs canonical)",
      "type": "table",
      "datasource": "$DS_PROMETHEUS",
      "description": "WI §6.1 panel 16 + framework §33.5.4.3 cap. APPROVED vs WAIVED-via-ADR-0034 (solo-tier dual-hat). Ship gate REJECTED if any seat missing both APPROVED + WAIVED.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 44 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max by (role) (corelink_prr_signoff_status{sprint=\"S-09\"})",
          "legendFormat": "{{role}}",
          "refId": "A"
        }
      ]
    }
  ],
