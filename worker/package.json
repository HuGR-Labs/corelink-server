{
  "name": "@corelink/worker",
  "private": true,
  "version": "0.1.0",
  "description": "CoreLink Cloudflare Worker shim + Durable Object container proxy.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --config ../wrangler.toml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:file": "vitest run",
    "test:miniflare": "vitest run --config vitest.miniflare.config.mts",
    "build": "wrangler deploy --dry-run --outdir ../dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "3.11.6",
    "@sentry/cloudflare": "^10.65.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@cloudflare/workers-types": "^4.20260619.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "miniflare": "^4.20260710.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}
