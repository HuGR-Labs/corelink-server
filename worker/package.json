{
  "name": "@corelink/worker",
  "private": true,
  "version": "0.1.0",
  "description": "CoreLink Cloudflare Worker shim + Durable Object container proxy.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --config ../wrangler.toml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:file": "vitest run",
    "test:miniflare": "vitest run --config vitest.miniflare.config.mts",
    "build": "wrangler deploy --dry-run --outdir ../dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@cloudflare/workers-types": "^4.20260526.1",
    "@vitest/coverage-istanbul": "^4.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.96.0"
  }
}
