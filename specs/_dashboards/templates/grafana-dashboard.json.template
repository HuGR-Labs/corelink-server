{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\", env=\"$env\"}",
        "hide": false,
        "iconColor": "red",
        "name": "Active alerts",
        "step": "60s",
        "titleFormat": "{{alertname}}"
      }
    ]
  },
  "description": "{{DESCRIPTION}}",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Dashboard spec (markdown)",
      "url": "{{SPEC_URL}}",
      "type": "link",
      "icon": "doc",
      "targetBlank": true
    },
    {
      "title": "DASH-INDEX (catalog)",
      "url": "https://github.com/HumanGuardrail/corelink-server/blob/main/specs/_dashboards/INDEX.md",
      "type": "link",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "panels": {{PANELS_JSON}},
  "refresh": "{{REFRESH}}",
  "schemaVersion": 39,
  "tags": ["corelink", "{{DASH_ID_LOWER}}", "{{AUDIENCE_TAG}}"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "label": "Datasource"
      },
      {
        "name": "env",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(corelink_cas_requests_total, env)",
        "current": { "selected": true, "text": "prod", "value": "prod" },
        "hide": 0,
        "label": "Environment",
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "region",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(corelink_cas_requests_total{env=\"$env\"}, region)",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "label": "Region",
        "refresh": 2,
        "regex": "",
        "includeAll": true,
        "multi": true
      }
      {{EXTRA_VARIABLES_JSON}}
    ]
  },
  "time": {
    "from": "{{TIME_FROM}}",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h", "6h", "12h", "24h"],
    "time_options": ["5m", "15m", "1h", "6h", "24h", "7d", "30d", "90d"]
  },
  "timezone": "utc",
  "title": "{{TITLE}}",
  "uid": "corelink-{{DASH_ID_LOWER}}",
  "version": 1,
  "weekStart": "monday"
}
