#!/usr/bin/env bash
# OKF self-healing — local git hook. Fires after a successful `git merge` / `git pull`.
# Detects OKF citation drift (fast, deterministic) and, only if drift exists AND you're on main,
# kicks off the reconcile agent in the BACKGROUND with your Codex CLI auth (no API key),
# in an isolated worktree (never touches your working tree), and opens a PR.
#
# INSTALL (one-time, per clone):   git config core.hooksPath hooks
# DISABLE:                         git config --unset core.hooksPath
# It never blocks your git pull; output goes to .git/okf-reconcile.log.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
LOG="$(git rev-parse --git-path okf-reconcile.log)"
note() { printf '[okf] %s\n' "$*" | tee -a "$LOG" >&2; }

# only on main, only if the tools are present
[[ "$(git rev-parse --abbrev-ref HEAD)" == "main" ]] || exit 0
if ! command -v codex >/dev/null; then
  note "reconcile not started: Codex CLI missing; run scripts/okf-reconcile-local.sh manually"
  exit 0
fi
if [[ ! -x scripts/okf-reconcile-local.sh ]]; then
  note "reconcile not started: scripts/okf-reconcile-local.sh is not executable"
  exit 0
fi

# fast drift check (no agent); bail silently if clean
if scripts/okf-reconcile-local.sh --check >/dev/null 2>&1; then
  exit 0   # 0 drift
else
  rc=$?
  if [[ "$rc" != 1 ]]; then
    note "reconcile check failed (exit $rc); manual review required"
    exit 0
  fi
fi

note "citation drift detected after merge — starting Codex in isolated worktree"
nohup scripts/okf-reconcile-local.sh --pr >> "$LOG" 2>&1 &
exit 0
