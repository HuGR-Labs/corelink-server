#!/usr/bin/env bash
# OKF self-healing — local git hook. Fires after a successful `git merge` / `git pull`.
# Detects OKF citation drift (fast, deterministic) and, only if drift exists AND you're on main,
# kicks off the reconcile agent in the BACKGROUND with your Claude Code CLI auth (no API key),
# in an isolated worktree (never touches your working tree), and opens a PR.
#
# INSTALL (one-time, per clone):   git config core.hooksPath hooks
# DISABLE:                         git config --unset core.hooksPath
# It never blocks your git pull; output goes to .git/okf-reconcile.log.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# only on main, only if the tools are present
[[ "$(git rev-parse --abbrev-ref HEAD)" == "main" ]] || exit 0
command -v claude >/dev/null || exit 0
[[ -x scripts/okf-reconcile-local.sh ]] || exit 0

# fast drift check (no agent); bail silently if clean
if scripts/okf-reconcile-local.sh --check >/dev/null 2>&1; then
  exit 0   # 0 drift
fi

echo "[okf] citation drift detected after merge — reconciling in the background (PR will open)…"
nohup scripts/okf-reconcile-local.sh --pr >> .git/okf-reconcile.log 2>&1 &
exit 0
