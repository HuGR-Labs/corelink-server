# CoreLink Buck2 Remote Cache Configuration Reference
#
# SECURITY: Never hard-code your PAT here. Use the CORELINK_PAT environment
# variable or store the token in a secrets manager and inject at build time.
# Committing credentials = CTRL-CRED-001 violation.
#
# Quick start:
#   export CORELINK_PAT=<your-token>
#   buck2 build :hello

[repository]
    name = buck2-starter

# Explicitly define the project cell. Buck2 requires the root cell mapping
# before it can resolve the starter's build graph.
[cells]
    root = .
    prelude = prelude
    toolchains = toolchains

[cell_aliases]
    config = prelude
    fbsource = root

[external_cells]
    prelude = bundled

[parser]
    # Resolve every root target against the bundled public default platform.
    # This keeps configuration features available without importing a
    # repository-specific or Meta-internal platform graph.
    target_platform_detector_spec = target:root//...->prelude//platforms:default

[buck2]
    execution_platforms = root//platforms:corelink-cache
    digest_algorithms = SHA256
    # The documented build report metrics are opt-in in the pinned Buck2
    # release.  Keep the report's cache counters available to CI and the
    # benchmark without changing remote-cache reads, writes, or retry policy.
    detailed_aggregated_metrics = true

[build]
    execution_platforms = root//platforms:corelink-cache

[corelink]
    provenance = $CORELINK_CACHE_PROVENANCE

[buck2_re_client]
    engine_address = $CORELINK_REAPI_ENDPOINT
    action_cache_address = $CORELINK_REAPI_ENDPOINT
    cas_address = $CORELINK_REAPI_ENDPOINT
    instance_name = $CORELINK_TENANT_ID
    http_headers = Authorization: Bearer $CORELINK_PAT

[client]
    # Enable BLAKE3 digest verification on every downloaded artifact.
    # Maps to CoreLink CTRL-CAS-002 (client-verify default-on).
    hash_algorithm = SHA256
