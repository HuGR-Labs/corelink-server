# CoreLink Bazel remote cache configuration (WI-S15-002 / WI-S15-005).
#
# SECURITY (CTRL-CRED-001 — Lote 10.15 codex P0 canonical fix):
#   Credentials are passed via the Bazel 6+ credential helper protocol — the
#   helper reads the CORELINK_PAT environment variable and emits a JSON token
#   response to stdout.  The PAT is NEVER placed in argv (no
#   --remote_header=Authorization:... which would expose the secret in
#   `ps aux` output).
#
# Usage:
#   export CORELINK_PAT=<your-pat>
#   bazel build //...
#
# See https://bazel.build/docs/credential-helper for the full specification.

# Remote cache endpoint.
# Live CoreLink Bazel REAPI v2 cache route (see routes/bazel_v2.rs).
build --remote_cache=https://corelink-api.humangr.com/bazel/cache

# Credential helper (Bazel 6+ protocol), SCOPED TO OUR HOST.
# The helper script at .bazel/corelink-credential-helper.sh reads CORELINK_PAT
# and emits:  {"headers": {"Authorization": ["Bearer <token>"]}}
#
# The `<host>=` prefix is not optional. An unscoped --credential_helper applies
# to EVERY URI Bazel fetches, so the helper was handing this tenant's PAT to
# bcr.bazel.build on every module-registry request -- a live credential sent to
# a third party on every build. bcr.bazel.build rejected it with 401, which is
# also why the cold build died before it ever reached CoreLink.
build --credential_helper=corelink-api.humangr.com=%workspace%/.bazel/corelink-credential-helper.sh

# Network tuning.
build --remote_timeout=30s
build --remote_retries=3

# Upload local results so subsequent builds by other engineers / CI runners
# benefit from the cache immediately.
build --remote_upload_local_results=true

# Minimise download: only fetch outputs explicitly requested.
# Speeds up CI where source artifacts are sufficient.
build --remote_download_minimal

# Zstandard compression over the wire (REAPI v2 standard).
build --experimental_remote_cache_compression=true

# Local defaults (always active).
build --show_progress_rate_limit=5
build --keep_going

# --- CI-only overrides (applied via --config=ci in CI workflow) ---
# In CI we enable full download so we can inspect + upload artifacts.
build:ci --remote_download_outputs=all
# The `--spawn_strategy=local` workaround that used to live here is GONE
# (2026-08-24, B-025). The runner image had no /dev/shm, so Bazel's Linux
# sandbox could not start at all; the entrypoint now provisions it
# (corelink-runners #502) and the fabric is pinned to that image (#503). The
# example builds sandboxed again, which is what a customer copying this file
# would get.
# In CI we pass --noremote_upload_local_results on the second (cache-hit) build
# to avoid re-uploading what is already in the cache; the CI workflow overrides
# this flag explicitly on the warm-cache invocation.
